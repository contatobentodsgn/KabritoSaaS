# ============================================================
# .env.example — copie para .env.local e preencha
# NUNCA versionar o .env real. Segredos NUNCA em componente client.
# (ver SECURITY_GUIDE.md §5)
# ============================================================

# --- Públicas (podem ir ao client) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Segredos de servidor (NUNCA no client) ---
# Usadas apenas em pipeline / cron / admin (ver SECURITY_GUIDE.md §3)
SUPABASE_SERVICE_ROLE_KEY=
# Conexão direta do Drizzle (pipeline/cron/admin). Ignora RLS — isolado de propósito.
DATABASE_URL=

# Protege os endpoints de cron (/api/cron/*). 401 sem ele.
CRON_SECRET=

# Provedor de IA do pipeline — NÃO preso a um fornecedor. Sem AI_API_KEY = mock.
AI_API_KEY=
AI_MODEL=claude-3-5-sonnet-latest
# AI_PROVIDER: "anthropic" (API nativa) | "openai" (Chat Completions compatível).
# Vazio = auto: usa "openai" se AI_BASE_URL estiver setado, senão "anthropic".
AI_PROVIDER=
# AI_BASE_URL: base da API OpenAI-compatível. Exemplos:
#   OpenAI       -> https://api.openai.com/v1        (AI_MODEL=gpt-4o-mini)
#   OpenRouter   -> https://openrouter.ai/api/v1     (AI_MODEL=anthropic/claude-sonnet-4.6, google/gemini-2.0-flash, ...)
#   Groq         -> https://api.groq.com/openai/v1   (AI_MODEL=llama-3.3-70b-versatile)
#   Gemini       -> https://generativelanguage.googleapis.com/v1beta/openai (AI_MODEL=gemini-2.0-flash)
AI_BASE_URL=
# Teto de custo por generation_run (USD). Estourou -> para e alerta (Sentry).
# (Custo é aproximado p/ não-Anthropic; o teto de tokens abaixo é exato.)
AI_RUN_COST_CAP_USD=2.00
# Teto de tokens por run.
AI_RUN_TOKEN_CAP=200000

# E-mail transacional / digest (use um dos dois)
RESEND_API_KEY=
EMAIL_FROM="Inteligência Criativa <digest@example.com>"
# BREVO_API_KEY=

# Monitoramento (Sentry) — tudo opcional; sem DSN o Sentry fica no-op.
# DSN do servidor (erros de server actions/route handlers/pipeline/cron):
SENTRY_DSN=
# DSN do client (público por design — captura erros no navegador). Pode ser o mesmo DSN.
NEXT_PUBLIC_SENTRY_DSN=
# Opcionais para upload de sourcemaps no build (stack traces legíveis):
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Controle de sessão — limite de dispositivos ativos por usuário (seção 11)
DEVICE_LIMIT=2

# Stripe (MVP 3 — billing real). Vazio = billing desligado (acesso manual via npm run grant).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=        # price_... do plano mensal
STRIPE_PRICE_ANNUAL=         # price_... do plano anual
