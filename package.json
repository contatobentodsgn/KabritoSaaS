{
  "name": "kabrito-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx db/migrate.ts",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx db/seed.ts",
    "seed:editions": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx db/seed-editions.ts",
    "setup:storage": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx db/setup-storage.ts",
    "check:supabase": "node --env-file-if-exists=.env.local --import tsx db/check-supabase.ts",
    "check:upstash": "node --env-file-if-exists=.env.local --import tsx server/rate-limit/check-upstash.ts",
    "check:resend": "node --env-file-if-exists=.env.local --import tsx server/admin/check-resend.ts",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls",
    "pipeline:run": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx server/pipeline/cli.ts",
    "grant": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx server/admin/grant-cli.ts",
    "staff": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx server/admin/staff-cli.ts",
    "seed:test-user": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx server/admin/seed-test-user.ts"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-avatar": "^1.2.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-select": "^2.3.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.15",
    "@sentry/nextjs": "^10.60.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.80.0",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^1.7.0",
    "stripe": "^22.2.3",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "autoprefixer": "^10.4.20",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.15.0",
    "globals": "^15.12.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.62.0",
    "vitest": "^2.1.6"
  }
}
