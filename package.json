{
  "name": "kabrito-saas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:deps": "npm audit --omit=dev --audit-level=high",
    "deadcode": "knip",
    "db:generate": "drizzle-kit generate",
    "db:gen-types": "supabase gen types typescript --linked --schema public > types/supabase.ts",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx db/migrate.ts",
    "db:seed": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx db/seed.ts",
    "seed:editions": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx db/seed-editions.ts",
    "setup:storage": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx db/setup-storage.ts",
    "check:supabase": "node --env-file-if-exists=.env.local --import tsx db/check-supabase.ts",
    "check:upstash": "node --env-file-if-exists=.env.local --import tsx server/rate-limit/check-upstash.ts",
    "db:backup": "node --env-file-if-exists=.env.local --import tsx db/backup.ts",
    "check:resend": "node --env-file-if-exists=.env.local --import tsx server/admin/check-resend.ts",
    "test": "vitest run",
    "test:rls": "vitest run tests/rls",
    "test:coverage": "vitest run --coverage",
    "pipeline:run": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx server/pipeline/cli.ts",
    "grant": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx server/admin/grant-cli.ts",
    "staff": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx server/admin/staff-cli.ts",
    "mfa:reset": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx server/admin/mfa-reset-cli.ts",
    "seed:test-user": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx server/admin/seed-test-user.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@sentry/nextjs": "^10.65.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.110.2",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.38.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "gsap": "^3.15.0",
    "lucide-react": "^1.48.0",
    "next": "^15.1.0",
    "postgres": "^3.4.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "sonner": "^1.7.0",
    "stripe": "^22.6.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^2.1.6",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "knip": "^6.38.0",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.6"
  }
}
